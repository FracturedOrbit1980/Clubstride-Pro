# Local Metro and `eas build --local` read this file. Cloud builds do not: set the same
# two names on the EAS environment named in eas.json (`eas env:set`, visibility plaintext).
# Anything named EXPO_PUBLIC_ is inlined into the JS bundle, so the anon key only ever
# belongs here, never a service_role key, a secret key, or a database password.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
