# Consumed by Expo at build time and inlined into the JS bundle. Anything named
# EXPO_PUBLIC_ is readable by anyone who unpacks the app, so the anon key only ever
# belongs here, never a service_role or db password.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
