{
  "expo": {
    "name": "Clubstride Pro",
    "slug": "clubstride-mobile",
    "owner": "fracturedorbit1980",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clubstride",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1630",
    "icon": "./assets/brand/app-icon.png",
    "ios": {
      "bundleIdentifier": "com.clubstride.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.clubstride.mobile",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundColor": "#0A1630",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-status-bar",
        {
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1630",
          "image": "./assets/brand/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "web": {
      "favicon": "./assets/brand/app-icon.png",
      "splash": {
        "image": "./assets/brand/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0A1630"
      }
    },
    "extra": {
      "expo-status-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "23f93edc-9acb-456f-a0c5-dbf8683e553a"
      }
    }
  }
}
