{
  "expo": {
    "name": "Clubstride Pro",
    "slug": "clubstride-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "clubstride",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A1630",
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1630"
    },
    "ios": {
      "bundleIdentifier": "com.clubstride.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.clubstride.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "backgroundColor": "#0A1630",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/brand/app-icon.png"
    }
  }
}
